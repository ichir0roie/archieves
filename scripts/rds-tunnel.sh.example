#!/usr/bin/env bash
# 踏み台EC2(SSHのみ、EC2 Instance Connect Endpoint経由)にSSHし、
# SSHのローカルフォワーディングで localhost:54000 から非公開RDS(PostgreSQL)へ転送する。
# 踏み台EC2・EICエンドポイント・SGルールは作成済みの前提。
#
# 参照: docs/インフラ/データベース/ローカル開発からのRDSアクセス.md
#
# 使い方:
#   cp scripts/rds-tunnel.sh.example scripts/rds-tunnel.sh
#   # scripts/rds-tunnel.sh 内のデフォルト値を自分のAWS環境の値に書き換える(gitignore対象)
#   ./scripts/rds-tunnel.sh

set -euo pipefail

BASTION_INSTANCE_ID="<BASTION_INSTANCE_ID>"
RDS_INSTANCE_ID="<RDS_INSTANCE_ID>"
LOCAL_PORT=54000
REMOTE_PORT=5432

RDS_ENDPOINT=$(aws rds describe-db-instances \
  --db-instance-identifier "$RDS_INSTANCE_ID" \
  --query "DBInstances[0].Endpoint.Address" --output text)

echo "[rds-tunnel] localhost:${LOCAL_PORT} -> (踏み台EC2経由) -> ${RDS_ENDPOINT}:${REMOTE_PORT} のトンネルを開始します(Ctrl+Cで終了)" >&2
exec aws ec2-instance-connect ssh \
  --instance-id "$BASTION_INSTANCE_ID" \
  --connection-type eice \
  --local-forwarding "${LOCAL_PORT}:${RDS_ENDPOINT}:${REMOTE_PORT}"
