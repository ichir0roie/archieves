{
  // F5 の既定は一番上。起きている画面(:3100)を Brave で開く。画面と API は tasks.json のタスクか tools.dev で先に起こす
  // Brave profile (userDataDir) lives in .vscode/chrome-user-data (gitignored)
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Brave: attach to running web (:3100)",
      "type": "chrome",
      "request": "launch",
      // chrome の型のデバッガーのまま、起こすブラウザーを Brave にする
      "runtimeExecutable": "/usr/bin/brave-browser",
      "url": "http://localhost:3100",
      "webRoot": "${workspaceFolder}/source/front",
      "userDataDir": "${workspaceFolder}/.vscode/chrome-user-data"
    },
    {
      // Use this to set breakpoints in the API (.env db)
      "name": "Python: API (debugpy, :8000)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "app.main:app",
        "--host",
        "127.0.0.1",
        "--port",
        "8000",
        "--reload",
        "--reload-dir",
        "app",
        "--reload-dir",
        "mods"
      ],
      "cwd": "${workspaceFolder}/source/back",
      "python": "${workspaceFolder}/source/back/.venv/bin/python",
      "envFile": "${workspaceFolder}/source/back/.env",
      "console": "integratedTerminal",
      "justMyCode": true,
      "preLaunchTask": "api: prepare (postgres + free :8000)"
    },
    {
      "name": "Python: current file (source/back)",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "cwd": "${workspaceFolder}/source/back",
      "python": "${workspaceFolder}/source/back/.venv/bin/python",
      "envFile": "${workspaceFolder}/source/back/.env",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/source/back"
      },
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ],
  "compounds": [
    {
      // Start API with debugpy and web with next dev, then open Brave
      "name": "API (debugpy) + Brave",
      "configurations": [
        "Python: API (debugpy, :8000)",
        "Brave: attach to running web (:3100)"
      ],
      "preLaunchTask": "front: start (.env.local, :3100)",
      "stopAll": true
    }
  ]
}
