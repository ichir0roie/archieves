# Runs the pytest suite on the same Python the deployed image uses
# (.build/Dockerfile's Lambda base is 3.14), so a dev machine's own, older
# python is never what the tests run on. The suite needs no database service
# of its own - it uses in-memory sqlite (see tests/conftest.py).
#
# Only the dependencies are baked in; the project itself is bind-mounted by
# the compose file, so editing a test and re-running needs no rebuild. Rebuild
# (--build) only when requirements change.
FROM python:3.14-slim

WORKDIR /app

COPY requirements.txt requirements-dev.txt ./
RUN pip install --no-cache-dir -r requirements-dev.txt

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

CMD ["python", "-m", "pytest"]
