# Runs the pytest suite on the same Python the deployed image uses
# (.build/Dockerfile's Lambda base is 3.14), against the postgres service in
# .build/docker-compose.test.yml rather than sqlite.
#
# Only the dependencies are baked in; the project itself is bind-mounted by
# the compose file, so editing a test and re-running needs no rebuild. Rebuild
# (--build) only when requirements change.
FROM python:3.14-slim

WORKDIR /app

COPY requirements.txt requirements-dev.txt ./
RUN pip install --no-cache-dir -r requirements-dev.txt

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

CMD ["python", "-m", "pytest"]
