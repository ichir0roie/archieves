PROJECT_NAME=archieves-api
API_V1_STR=/api/v1
ENV=local
DB_DRIVER=postgresql+psycopg2
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=archieves
# Set DATABASE_URL to override the DB_* fields above with a full connection string
DATABASE_URL=
BACKEND_CORS_ORIGINS=["*"]
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=0
DB_POOL_PRE_PING=true
# "flush" or "commit" - how mods.factory_db factories persist created objects
FACTORY_SESSION_PERSISTENCE=flush
# Cognito user pool backing authentication (see app/core/security.py)
AWS_REGION=ap-northeast-1
USERPOOL_ID=
APP_CLIENT_ID=

# "mock" (default here) skips Cognito entirely and authenticates every
# request as the MOCK_USER_* identity below - no AWS credentials or user
# pool needed, matching the archieves frontend's NEXT_PUBLIC_AUTH_MODE=mock.
# Set to "cognito" to verify real bearer tokens against the pool above.
AUTH_MODE=mock
MOCK_USER_SUB=local-dev-user
MOCK_USER_USERNAME=local-dev-user
MOCK_USER_EMAIL=dev@example.com
