# Base URL of archieves-api. Match whichever port you started it on:
# - `uvicorn app.main:app --reload` (no Docker) -> :8000 (this default)
# - `docker compose -f .build/docker-compose.yml up` -> :8080
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# "mock" (default) skips Amplify/Cognito entirely: no amplify_outputs.json
# from a real `ampx sandbox`, no AWS credentials, every page renders signed
# in as the fixed NEXT_PUBLIC_MOCK_USER_* identity below. Keep this in sync
# with AUTH_MODE=mock in archieves-api's own .env.
# Set to "cognito" to run the real Amplify Authenticator sign-in flow
# against a provisioned user pool (requires `npx ampx sandbox` first).
NEXT_PUBLIC_AUTH_MODE=mock
NEXT_PUBLIC_MOCK_USER_SUB=local-dev-user
NEXT_PUBLIC_MOCK_USER_USERNAME=local-dev-user
NEXT_PUBLIC_MOCK_USER_EMAIL=dev@example.com
