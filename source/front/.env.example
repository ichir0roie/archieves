# archieves-api の在りか。ブラウザは直に叩かず、src/app/api/v1 の route handler が流す(サーバーだけが読む)
# - `python -m tools.dev`(source/back)・`uvicorn app.main:app` -> :8000(既定)
# - テスト用の API サーバー・docker compose -> :8080
ARCHIEVES_API_URL=http://127.0.0.1:8000
# API の API_KEYS のうちの一つの鍵。手元の API が API_KEYS を持たなければ要らない
ARCHIEVES_API_KEY=

# "mock" なら Amplify・Cognito を通さず、下の NEXT_PUBLIC_MOCK_USER_* の利用者としてログインした扱いにする。
# API の AUTH_MODE=mock と揃える。"cognito" は `npx ampx sandbox` の amplify_outputs.json で本物のログインをする
NEXT_PUBLIC_AUTH_MODE=mock
NEXT_PUBLIC_MOCK_USER_SUB=local-dev-user
NEXT_PUBLIC_MOCK_USER_USERNAME=local-dev-user
NEXT_PUBLIC_MOCK_USER_EMAIL=dev@example.com
